# Шаблон env для agent-system. Скопировать в .env и заполнить ключами.
# ПРАВИЛО: пустой <AGENT>_API_KEY => агент не используется. .env в .gitignore.

# GPT (OpenAI) — модель должна быть доступна проекту ключа (частая ошибка: нет доступа к gpt-4.1-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Gemini (Google)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# GLM (z.ai)
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL=glm-4.6

# Kimi (Moonshot) — .ai = международный эндпоинт, .cn = китайский (ключи не взаимозаменяемы)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=moonshot-v1-32k

# Deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Grok (xAI)
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest

# Движок
DEBATE_MAX_ROUNDS=3
QUANTUM_BRANCHES_PER_GEN=12
QUANTUM_TOP_K=5
QUANTUM_MAX_GENERATIONS=3
LLM_TIMEOUT_SECONDS=60

AGENT_SYSTEM_API_KEY=change-me-shared-secret

# CORS: пусто = выключен (прод). Для локального HTML-демо в браузере: CORS_ORIGINS=*
CORS_ORIGINS=

# Модель приёмщика /debates/intake. Пусто = авто (Kimi первым — быстрый и стабильный JSON).
# Когда у GPT появится биллинг — можно INTAKE_MODEL=GPT.
INTAKE_MODEL=
